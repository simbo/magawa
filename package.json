{
  "name": "magawa",
  "description": "A minesweeper clone.",
  "version": "0.13.2",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://simbo.de/magawa",
  "bugs": {
    "url": "https://github.com/simbo/magawa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simbo/magawa.git"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "scripts": {
    "browserslist": "browserslist",
    "browserslist:update": "pnpm exec update-browserslist-db",
    "build": "pnpm run check:types && vite build",
    "bundle-analyzer": "pnpm exec vite-bundle-visualizer",
    "check": "pnpm run check:eslint && pnpm run check:format && pnpm run check:types && pnpm run check:spelling",
    "check:eslint": "eslint --config ./eslint.config.ts --max-warnings 0 .",
    "check:format": "prettier --check .",
    "check:spelling": "cspell",
    "check:types": "tsc --project tsconfig.browser.json && tsc --project tsconfig.node.json && tsc --project tsconfig.tests.json",
    "clean": "pnpm run clean:coverage && pnpm run clean:node_modules",
    "clean:coverage": "rm -rf coverage",
    "clean:node_modules": "rm -rf node_modules",
    "fix": "pnpm run fix:eslint && pnpm run fix:format",
    "fix:eslint": "pnpm run check:eslint --fix",
    "fix:format": "prettier --write .",
    "dev": "vite --clearScreen false --host",
    "ncu:latest": "ncu --interactive --target latest --reject='/^(@types/node|typescript)$/'",
    "ncu:minor": "ncu --interactive --target minor",
    "ncu:patch": "ncu --interactive --target patch",
    "preflight": "pnpm run check && pnpm run build && pnpm run test",
    "preview": "vite preview",
    "prepare": "husky",
    "start": "pnpm run dev",
    "test": "vitest run --coverage",
    "test:watch": "vitest dev --coverage",
    "test:ui": "pnpm run test:watch --ui"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "array-shuffle": "^4.1.0",
    "css-reset-and-normalize": "^2.3.6",
    "date-fns": "^4.4.0",
    "lz-string": "^1.5.0",
    "path-slashes": "^2.0.1",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@simbo/commitlint-config": "^2.0.0",
    "@simbo/cspell-config": "^2.1.0",
    "@simbo/eslint-config": "^3.2.0",
    "@simbo/prettier-config": "^3.0.1",
    "@simbo/tsconfig": "^2.0.0",
    "@testing-library/preact": "^3.2.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.19.0",
    "@types/nunjucks": "^3.2.6",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.3",
    "cspell": "^10.3.6",
    "cssnano": "^9.1.2",
    "eslint": "^10.11.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "npm-check-updates": "^23.1.0",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "update-browserslist-db": "^1.3.3",
    "vite": "^8.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^5.0.3"
  }
}
