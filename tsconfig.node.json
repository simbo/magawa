{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@simbo/tsconfig/node",
  "include": ["*.ts", "package.json"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  }
}
